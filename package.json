{
  "name": "countersign",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter @countersign/web dev",
    "dev:worker": "pnpm --filter @countersign/worker dev",
    "dev:vi": "uv run --project apps/vi uvicorn vi_service.main:app --app-dir apps/vi/src --host 127.0.0.1 --port 8000",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "pnpm -r build",
    "start": "pnpm --filter @countersign/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && node scripts/check-money-discipline.mjs",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run --testTimeout=30000 --hookTimeout=30000 --maxWorkers=6",
    "test:watch": "vitest",
    "test:pkg": "pnpm -r test",
    "test:ec": "node scripts/ec-coverage.mjs",
    "test:ec:report": "node scripts/ec-coverage.mjs --report",
    "test:ci": "vitest --run --testTimeout=30000 --hookTimeout=30000 --maxWorkers=6",
    "vitest": "vitest",
    "db:migrate": "pnpm --filter @countersign/db migrate",
    "db:seed": "pnpm --filter @countersign/db seed",
    "db:studio": "pnpm --filter @countersign/db exec drizzle-kit studio",
    "vi:test": "uv run --project apps/vi pytest",
    "vi:lint": "uv run --project apps/vi ruff check apps/vi/src apps/vi/tests",
    "ec:gen": "node scripts/gen-edge-cases.mjs",
    "ec:check": "node scripts/gen-edge-cases.mjs --check",
    "money:check": "node scripts/check-money-discipline.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "mcp:token": "tsx scripts/mint-agent-token.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
