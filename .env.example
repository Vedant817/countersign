# =============================================================================================
# Countersign — environment template
# =============================================================================================
#
# Copy to `.env.local` and fill in. **`.env*` is git-ignored; only this file is committed.**
#   cp .env.example .env.local
#
# Secrets are read from environment variables only (spec §6). Nothing in this repository reads a
# secret from a file it also writes, and `packages/core/src/env.ts` refuses to boot if a required
# variable is missing or if `PAYPAL_ENV` is anything other than `sandbox`.
#
# Where the values come from: `docs/HUMAN_TODO.md`. H-01 PayPal sandbox app, H-02 OpenAI key,
# H-03 Render. The ones marked "generate" can be produced locally with the command shown.
#
# ---------------------------------------------------------------------------------------------
# 1. Application
# ---------------------------------------------------------------------------------------------

# local | render | ci | test
APP_ENV=local

# The deployed origin. This value is baked into evidence packets (as the only permitted URL in
# dispute notes, spec §8.15) and into the QR code on the evidence PDF, so it must be correct in
# production and is deliberately wrong-looking locally.
PUBLIC_BASE_URL=http://localhost:3000

# development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------------------------------
# 2. Database (spec D11 — Postgres 17)
# ---------------------------------------------------------------------------------------------
#
# Local: `docker compose up -d db` gives you postgres:17 on 5432 with the values below.
# Render: the internal connection string Render prints for the attached database.
DATABASE_URL=postgres://countersign:countersign@localhost:5432/countersign

# ---------------------------------------------------------------------------------------------
# 3. Sessions (spec D14 — iron-session, seeded personas)
# ---------------------------------------------------------------------------------------------
#
# generate: openssl rand -base64 48
# Must be 32+ characters. iron-session uses it to seal the persona cookie.
SESSION_SECRET=CHANGE_ME_48_random_characters_minimum_xxxxxxxxxxxxxxx

# The merchant's sign-in password (D-059). Read only by `pnpm db:seed`; the seed stores a scrypt hash on
# the Northwind merchant row and the web app never sees the plaintext. Leave it empty on a deployment that
# has no password login: the seed then leaves `password_hash` null, and `/login` refuses every attempt
# rather than accepting a password nobody set. Changing this value and re-running the seed is how the
# merchant's password is rotated.
MERCHANT_PASSWORD=

# ---------------------------------------------------------------------------------------------
# 4. PayPal (spec D6, §10.2 — SANDBOX ONLY)
# ---------------------------------------------------------------------------------------------
#
# EC-ENV-1: `PAYPAL_ENV` must be the literal string `sandbox`. The value `live` is REJECTED at boot
# by packages/core/src/env.ts, and PAYPAL_API_BASE must resolve to a *.sandbox.paypal.com host.
# This project does not support live mode — see spec §2 and docs/SANDBOX-VS-LIVE.md.
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# From Dashboard → Apps & Credentials → Sandbox → your REST app (HUMAN_TODO H-01 step 2).
# Without Vault / "Save payment methods" enabled, /v3/vault/* returns 400.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Dashboard → Apps & Credentials → your app → Webhooks → the registered webhook's ID (H-01 step 4).
# Needed for POST /v1/notifications/verify-webhook-signature. Leave blank locally if you have not
# registered one; the ingest route then refuses to trust the event (EC-WH-4).
PAYPAL_WEBHOOK_ID=

# Sandbox Personal account used by the dispute simulators and the nightly suite (H-01 step 5).
# The account must have a balance and a linked card — process-chargeback requires a card-funded
# transaction (spec §10.1 step 5, [S29]).
PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_PASSWORD=

# Sandbox Business account id, required by POST /v2/customer-support/process-chargeback.
# Dashboard → account details. See HUMAN_TODO H-09.
PAYPAL_MERCHANT_ID=

# The buyer-side transaction id for a capture. `POST /v1/customer/disputes` takes
# disputed_transactions[].buyer_transaction_id, which is the id from the BUYER's view of the
# transaction, not the merchant's capture id. A capture id alone cannot simulate a dispute.
# See HUMAN_TODO H-09.
PAYPAL_TEST_BUYER_TRANSACTION_ID=

# PayPal MCP server (spec D7, [B9] — https://developer.paypal.com/ai-tools/mcp-server).
# remote = the hosted sandbox server; local = `npx @paypal/mcp` over stdio inside the worker.
# Week-1 check C3(b) decides which works; see docs/week1-results.md.
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/sse
PAYPAL_MCP_MODE=remote

# ---------------------------------------------------------------------------------------------
# 5. The model provider (spec D8)
# ---------------------------------------------------------------------------------------------
#
# LLM_MAIN_MODEL compiles intents, drives the shopping agent, plans evidence and drafts notes.
# LLM_CHEAP_MODEL runs the classifier and the bulk eval suites (about 20x cheaper).
# No LLM output is ever authoritative: it is zod-validated, shown to a human, or checked by
# deterministic code before any side effect (spec §8.0 rule 4).
#
# --- This is optional, and the product works without it -------------------------------------
#
# The Gate, the liability router, the compiler's read-back, the order path and the public verifier
# are deterministic and need no model at all. A missing key costs you intent compilation and
# dispute-note drafting, nothing else, and `/status` says so rather than failing the boot.
#
# --- Any OpenAI-compatible provider works ------------------------------------------------
#
# OPENAI_BASE_URL points the client at the provider. Every option below speaks the same
# `/v1/chat/completions` protocol, so switching is one line:
#
#   OpenAI          https://api.openai.com/v1                                  paid
#   Groq            https://api.groq.com/openai/v1                             free tier, very fast
#   OpenRouter      https://openrouter.ai/api/v1                               models suffixed ":free"
#   Google AI Studio https://generativelanguage.googleapis.com/v1beta/openai   free tier
#   Together        https://api.together.xyz/v1                                free tier
#   Cerebras        https://api.cerebras.ai/v1                                 free tier, very fast
#   Ollama (local)  http://127.0.0.1:11434/v1                                  no key, no network
#
# For Ollama, set OPENAI_API_KEY to any non-empty string (the client requires one) and point the
# model names at whatever `ollama list` shows, e.g. `llama3.1:8b`.
OPENAI_API_KEY=
# A Modal Endpoint (token-billed, no idle cost) needs proxy headers rather than a Bearer:
#   OPENAI_BASE_URL=https://<workspace>--<endpoint>-server.<region>.modal.direct/v1
# with MODAL_PROXY_TOKEN_ID / MODAL_PROXY_TOKEN_SECRET below. See docs/LLM-ENDPOINT.md.
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MAIN_MODEL=

# Modal proxy auth, only for a `.direct` endpoint that reports requires_proxy_auth: true.
# Create at https://modal.com/settings/proxy-auth-tokens — there is no CLI command for these.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# ---------------------------------------------------------------------------------------------
# 6. vi-service (spec D2, D20 — private network only, never exposed)
# ---------------------------------------------------------------------------------------------
#
# Locally: http://127.0.0.1:8000. On Render: the private service URL, http://vi:8000.
VI_SERVICE_URL=http://127.0.0.1:8000

# Shared bearer for service-to-service calls. generate: openssl rand -hex 32
VI_SERVICE_TOKEN=

# Key-encryption key (AES-256-GCM) wrapping the per-agent private keys held by vi-service
# (spec D5). EXACTLY 32 bytes, base64. Losing it means agent keys are unrecoverable and users must
# re-approve their mandates — documented and drilled as EC-KEY-4.
# generate: openssl rand -base64 32
# Back this up in Render's env AND in 1Password. It cannot be recovered from a database.
VI_KEK=

# Key identifiers. The public halves of every kid ever issued stay in JWKS with a status, so
# evidence filed months ago still verifies after a rotation (EC-KEY-2, EC-KEY-3).
# REQUIRED — vi-service refuses to boot without them and packages/core/src/env.ts refuses to boot
# without them. There is no default: a defaulted kid is a made-up key name in every signed header.
VI_ISSUER_KID=issuer-1
VI_MERCHANT_KID=merchant-1

# The `iss` of the L1 issuer credential (spec §8.3 `POST /v1/l1/issue`) — the identity this
# deployment signs AS, so put this deployment's own origin here (Render: the private vi-service URL;
# locally: http://127.0.0.1:8000). The library's pinned `vct`
# (https://credentials.mastercard.com/card) is separate and unchanged: `iss` is ours.
# REQUIRED, no default. It used to default to https://www.mastercard.com, so a deployment that
# forgot this variable signed credentials claiming to be Mastercard. `.example`/`.invalid` hosts are
# rejected at boot — they can never resolve.
VI_ISSUER_URL=

# The `iss` written into L3a/L3b when the caller does not supply one (spec §8.3 `POST /v1/l3/create`):
# the agent's own origin — the domain the agent presents itself under, not this service's.
# REQUIRED, no default. It used to default to https://agent.countersign.example, an RFC 2606
# reserved TLD that never resolves, so every L3 it issued was unverifiable by construction.
VI_AGENT_ISS=

# Allowed clock skew, in seconds. 300 is the Verifiable Intent library default (spec §8.3, [B2]);
# this is the tolerance between our host and vi-service, not a licence to accept old mandates.
VI_CLOCK_SKEW_SECONDS=300

# ---------------------------------------------------------------------------------------------
# 7. Gate (spec §8.10 — the deterministic policy enforcement point)
# ---------------------------------------------------------------------------------------------
#
# kid and the **Ed25519** private JWK used to sign decision records. Those records are what a judge
# or a PayPal auditor verifies, so the key needs somewhere safe to live: Render secret env + 1Password.
GATE_KID=gate-1

# A JWK with kty=OKP, crv=Ed25519 and the private scalar d. generate with:
#   node -e "const{generateKeyPairSync}=require('crypto');console.log(JSON.stringify(generateKeyPairSync('ed25519').privateKey.export({format:'jwk'})))"
#
# **Ed25519, not P-256.** `signDecisionRecord` sets `alg: 'EdDSA'`
# (packages/gate/src/decision-record.ts), so the key must be OKP/Ed25519. An EC P-256 key imports
# cleanly and then fails at the first `sign()` — jose validates the algorithm against the key type —
# which surfaces as "Could not sign the Gate decision record" on a live request rather than at boot.
# `apps/web/lib/gate-runtime.ts` checks kty/crv before importing and refuses with the reason.
GATE_SIGNING_KEY=

# ---------------------------------------------------------------------------------------------
# 8. Feature flags and tuning
# ---------------------------------------------------------------------------------------------

# How long a merchant-signed checkout JWT locks prices (spec §8.9). After this, the agent must
# re-quote and the Gate re-checks the mandate cap (EC-PRICE-1).
CHECKOUT_PRICE_LOCK_SECONDS=900

# Bryntum Scheduler for the dispute-deadline timeline (spec D16, S-17). Trial licence needed for the
# judging period — HUMAN_TODO H-05. The disputes screen has a plain-table fallback when false, so
# nothing is blocked either way.
FEATURE_BRYNTUM=false

# WebAuthn passkey user-verification before every L2 signature (spec D4). This is what makes a new
# mandate require a verified human, which is the EC-FAM-1 control.
FEATURE_WEBAUTHN=true

# /judge — the one-click four-scenario sandbox runner (spec §8.20).
FEATURE_JUDGE_MODE=true

# ---------------------------------------------------------------------------------------------
# 9. Retention (spec §12.13 — DPDP Rules 2025 + GDPR)
# ---------------------------------------------------------------------------------------------
#
# 365 days is the DPDP Rule 8(3) minimum for data, traffic data and processing logs.
# 540 days covers PayPal's dispute windows plus that year of logs.
RETENTION_DAYS_OPERATIONAL=365
RETENTION_DAYS_EVIDENCE=540

# ---------------------------------------------------------------------------------------------
# 10. Observability (optional)
# ---------------------------------------------------------------------------------------------

# error | warn | info | debug. `info` in production.
LOG_LEVEL=info

# Off by default. When set, SENTRY_DSN must never be logged (it is in SECRET_ENV_KEYS).
SENTRY_DSN=

# Worker identity, written to worker_job_runs.worker_id so two instances can be told apart. Defaults to
# hostname-pid when absent, which is right for a container and poor for a dashboard — set it to
# "countersign-worker-1" on Render.
WORKER_ID=

# §8.19. The worker's own GET /health listener, off unless this is set: a Render background worker has no
# port for the platform to probe, so the heartbeat table (read by web /status) is the primary signal and
# this is for an operator or an external monitor. A value that is not a port fails the worker's boot (78).
WORKER_HEALTH_PORT=

# =============================================================================================
# Local-only notes (never committed)
# =============================================================================================
#
# A secrets scan (gitleaks) runs in CI and before every push. If it ever fires on this file, that is a
# false positive worth fixing with an allowlist entry and a comment — never by widening the scan.
#
# Cross-border transfer: an India-based user's data is processed on Render (Singapore region) and
# sent to OpenAI. Disclosed in the privacy notice (spec EC-PRIV-6).
#
# `domains[]` for the PayPal client token needs the deployed origins, so it is not hard-coded here —
# see HUMAN_TODO H-03.
# ---------------------------------------------------------------------------------------------
# Merchant identity (added later) � signed into every checkout JWT. No defaults, on purpose.
# ---------------------------------------------------------------------------------------------
#
# These three are the merchant this deployment sells AS. They end up inside a merchant-signed
# checkout JWT and on the receipt, so a default would be a fabricated value inside a signature the
# other side cannot detect � the argument D-040 and D-042 both make. Without them the shop refuses
# to quote rather than signing a merchant that does not exist.
MERCHANT_ID=mrc_northwind
MERCHANT_NAME=Northwind Outfitters
MERCHANT_WEBSITE=https://northwind.countersign.test