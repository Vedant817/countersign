{
  "name": "@countersign/vi-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "schema-drift": "tsx src/schema-drift-cli.ts"
  },
  "dependencies": {
    "@countersign/core": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "tsx": "4.23.15",
    "fast-check": "4.10.2"
  }
}
