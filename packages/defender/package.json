    "@countersign/evidence-pdf": "workspace:*",
    "@countersign/paypal": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "ai": "7.0.127",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "fast-check": "4.10.2",
    "jsqr": "1.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
