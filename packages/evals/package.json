{
  "name": "@countersign/evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval:live": "tsx src/run.ts",
    "eval:compiler": "tsx src/run.ts --compiler-only",
    "eval:injection": "tsx src/run.ts --injection-only"
  },
  "dependencies": {
    "@countersign/core": "workspace:*",
    "@countersign/defender": "workspace:*",
    "@countersign/compiler": "workspace:*",
    "@countersign/agent": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "tsx": "4.23.15",
    "fast-check": "4.10.2"
  }
}
