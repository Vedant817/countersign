*.sqlite
*.sqlite3
*.db
dump.rdb
.pgdata/
.tmp/
tmp/
outbox/
artifacts/
*.log

# downloaded sandbox evidence / captured fixtures that may contain PII are committed
# explicitly under packages/paypal/test/fixtures/<date>/ (spec §10.3); local scratch
# captures go to .artifacts/ and are ignored.
.artifacts/

