# ---- secrets: never commit real env files (spec §6: secrets only from env vars) ----
.env
.env.*
!.env.example

# ---- node ----
node_modules/
.pnpm-store/
.next/
out/
build/
dist/
.turbo/
.cache/
*.tsbuildinfo
next-env.d.ts
# A declaration beside its source is always a stray emit, never a file to track: packages ship
# declarations from `dist/` via `tsconfig.build.json`, and `git ls-files "*.d.ts"` returns nothing by
# design. `tsconfig.base.json` sets `declaration` + `declarationMap`, so any `tsc` run that does not
# inherit a `noEmit` over a `test/**/*.ts` include drops these into the source tree. They are build
# output with a nine-day-old mtime, not work.
*.d.ts
*.d.ts.map
.eslintcache
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/
.vitest/

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
uv.lock.tmp
dist/

